# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Onde encontrar: painel do Supabase > Project Settings > API
#   - Project URL         -> VITE_SUPABASE_URL
#   - anon / public key   -> VITE_SUPABASE_ANON_KEY
#
# A chave "anon" é pública (vai para o navegador), não tem problema.
# NUNCA coloque aqui a chave "service_role": ela dá acesso total ao banco.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
